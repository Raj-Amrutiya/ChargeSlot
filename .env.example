# ChargeSlot Environment Variables Template

# Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# For local development with local mongod:
MONGODB_URI=mongodb://127.0.0.1:27017/chargeslot
# For Docker Compose:
# MONGODB_URI=mongodb://mongo:27017/chargeslot

# Authentication & Security
JWT_SECRET=chargeslot_super_secret_jwt_key_2026_secure_random
JWT_EXPIRES_IN=7d
COOKIE_SECRET=chargeslot_cookie_signing_secret_987654321
